#   files:       the build root at $DESTDIR (read-write during finalize)
#   secrets:     none
#   prereqs:     executed by mkosi only; requires the base packages installed
#   precedence:  mkosi-set env > built-in default
#   validation:  $DESTDIR must be a writable chroot path
#   failure:     non-zero exit aborts the mkosi build


