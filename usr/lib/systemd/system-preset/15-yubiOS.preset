# Enable yubiOS services on first-boot preset
# PIV/CCID for Secure Boot signing
enable pcscd.service
# socket-activated alternative
enable pcscd.socket
# firstboot enrollment wizard trigger
enable yubiOS-enroll.service
# portable LUKS2 home directories (YubiKey FIDO2 unlock)
enable systemd-homed.service


