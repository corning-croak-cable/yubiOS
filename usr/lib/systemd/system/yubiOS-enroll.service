# yubiOS first-boot enrollment wizard
# Waits for a YubiKey to be detected, then prompts the user to enroll.
# Runs once (ConditionFirstBoot=yes) and marks itself complete.

[Unit]
Description=yubiOS YubiKey Enrollment Wizard (First Boot)
After=local-fs.target systemd-logind.service
Wants=pcscd.service
After=pcscd.service
ConditionFirstBoot=yes
ConditionPathExists=!/var/lib/yubiOS/.enrolled

[Service]
Type=oneshot
RemainAfterExit=yes
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=tty
StandardError=tty
ExecStart=/usr/lib/yubiOS/enroll.sh
ExecStartPost=/bin/mkdir -p /var/lib/yubiOS
ExecStartPost=/bin/touch /var/lib/yubiOS/.enrolled
# ADR-016 / systemd.exec(5) v250: deny network filesystems for enrollment service
# RestrictFileSystems= added in systemd v250 (not v261 as originally stated).
# Uses deny-list so all local block/API filesystems (btrfs, ext4, tmpfs, proc, sysfs)
# remain accessible; only network filesystems are blocked.
# Pre-requisite: verify LSM eBPF hook is enabled:
#   systemd-analyze filesystems 2>/dev/null | grep -i bpf
# or: grep CONFIG_BPF_LSM /boot/config-$(uname -r)
# If not supported, this directive is silently ignored.
RestrictFileSystems=~@network

[Install]
WantedBy=first-boot-complete.target
