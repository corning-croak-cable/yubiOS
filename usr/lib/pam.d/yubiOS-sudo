# yubiOS PAM config for sudo — copy to /etc/pam.d/sudo
#
# pam_u2f.so: "required" (not "sufficient") — YubiKey touch is ALWAYS needed.
# This is intentional. To skip, boot to recovery shell (see ONBOARDING.md).
#
# pam-u2f >= 1.3.1 required (CVE-2025-23023).
# authfile: central key file, root-owned, mode 600.
# cue: prints "Please touch your YubiKey" prompt.
# origin: appid for the U2F credential (must match enrollment).
#
# Source: https://github.com/Yubico/pam-u2f
# Source: https://www.yubico.com/support/security-advisories/ysa-2025-01/

#%PAM-1.0
auth       required   pam_u2f.so authfile=/etc/yubico/u2f_keys cue
auth       include    system-auth
account    include    system-auth
session    include    system-auth


