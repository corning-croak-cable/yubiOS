# yubiOS system-auth PAM stack
# Copy to /etc/pam.d/system-auth (done in Containerfile).
#
# Design:
#   Homed users  — pam_systemd_home.so handles auth (includes their FIDO2/PKCS11
#                  enrollment); on success=done the rest of the auth stack is skipped.
#   Classic users — pam_u2f.so (required) + pam_unix.so handle auth.
#
# pam_systemd_home.so suspend=1: forgets key material on system suspend.
# Graphical lock screens that re-auth via PAM will resume seamlessly.
# TTY sessions will appear hung on resume until re-auth from another terminal.
#
# Recovery if locked out: boot with rd.break, remount rw, comment out pam_u2f line.
# Source: https://www.man7.org/linux/man-pages/man8/pam_systemd_home.8.html
# Source: https://github.com/Yubico/pam-u2f (CVE-2025-23013: requires >= 1.3.1)

#%PAM-1.0

# ── auth ─────────────────────────────────────────────────────────────────────
# Homed users: FIDO2/PKCS11 handled by homed itself; success skips rest of stack.
-auth [success=done authtok_err=bad perm_denied=bad maxtries=bad default=ignore] pam_systemd_home.so
# Classic users: FIDO2 second factor (touch required) + password.
auth      required   pam_u2f.so authfile=/etc/yubico/u2f_keys cue origin=pam://yubiOS
auth      sufficient pam_unix.so try_first_pass
auth      required   pam_deny.so

# ── account ──────────────────────────────────────────────────────────────────
-account [success=done authtok_expired=bad new_authtok_reqd=bad maxtries=bad acct_expired=bad default=ignore] pam_systemd_home.so
account   required   pam_nologin.so
account   required   pam_unix.so

# ── password ─────────────────────────────────────────────────────────────────
-password sufficient pam_systemd_home.so
password  sufficient pam_unix.so sha512 shadow try_first_pass use_authtok
password  required   pam_deny.so

# ── session ──────────────────────────────────────────────────────────────────
-session  optional   pam_keyinit.so revoke
-session  optional   pam_limits.so
# suspend=1: drop key material from RAM on system suspend
-session  optional   pam_systemd_home.so suspend=1
-session  optional   pam_systemd.so
 session  required   pam_unix.so


